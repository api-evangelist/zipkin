          "request": {
            "name": "Zipkin Get Dependency Links",
            "description": {
              "content": "Returns dependency links derived from spans. Dependencies show which services call which other services, along with call counts and error counts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "dependencies"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "endTs",
                  "value": "<long>",
                  "description": "(Required) Upper bound timestamp for dependency links, in epoch milliseconds."
                },
                {
                  "disabled": false,
                  "key": "lookback",
                  "value": "<long>",
                  "description": "How far back from endTs to look, in milliseconds."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
