        {
          "id": "016715e9-8040-4bad-9c86-a73c03036856",
          "name": "Zipkin Search for Traces",
          "request": {
            "name": "Zipkin Search for Traces",
            "description": {
              "content": "Searches for traces matching the given query parameters. Results are sorted by descending end timestamp.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "traces"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "serviceName",
                  "value": "<string>",
                  "description": "Service name to query for"
                },
                {
                  "disabled": false,
                  "key": "spanName",
                  "value": "<string>",
                  "description": "Span name to query for"
                },
                {
                  "disabled": false,
                  "key": "annotationQuery",
                  "value": "<string>",
                  "description": "Annotation query string, e.g. \"http.method=GET\" or \"error\""
                },
                {
                  "disabled": false,
                  "key": "minDuration",
                  "value": "<long>",
                  "description": "Minimum duration in microseconds"
                },
                {
                  "disabled": false,
                  "key": "maxDuration",
                  "value": "<long>",
                  "description": "Maximum duration in microseconds"
                },
                {
                  "disabled": false,
                  "key": "endTs",
                  "value": "<long>",
                  "description": "Upper bound on the timestamp of the first span in a trace, in epoch milliseconds. Defaults to current time."
                },
                {
                  "disabled": false,
                  "key": "lookback",
                  "value": "<long>",
                  "description": "How far back to look from endTs, in milliseconds. Defaults to endTs, limited to a system-configured max."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of traces to return. Defaults to 10."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
